# ── Facebook Ads ──────────────────────────────────────────────
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
FB_ACCESS_TOKEN=your_long_lived_access_token
FB_AD_ACCOUNT_ID=act_your_ad_account_id

# ── Google Ads ────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_oauth2_client_id
GOOGLE_ADS_CLIENT_SECRET=your_oauth2_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_oauth2_refresh_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_mcc_customer_id
GOOGLE_ADS_CUSTOMER_ID=your_ads_customer_id

# ── QDM Website Backend ───────────────────────────────────────
QDM_BASE_URL=https://your-qdm-domain.com
QDM_API_KEY=your_qdm_api_key
QDM_USERNAME=your_qdm_username
QDM_PASSWORD=your_qdm_password

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
# 逗號分隔的允許來源，生產環境請設為實際前端網域
CORS_ORIGINS=["https://your-frontend.com"]
